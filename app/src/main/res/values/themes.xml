<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RentFlow" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary branding color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>

        <!-- Status and background coloring -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.RentFlow" parent="Base.Theme.RentFlow" />

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/App.ActiveIndicator</item>
        <item name="itemTextAppearanceActive">@style/App.BottomNav.Text.Selected</item>
        <item name="itemTextAppearanceInactive">@style/App.BottomNav.Text</item>
    </style>

    <style name="App.BottomNav.Text" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="App.BottomNav.Text.Selected" parent="App.BottomNav.Text">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/secondary_container</item>
        <item name="android:width">44dp</item>
        <item name="android:height">24dp</item>
    </style>

    <!-- Restoring the splash theme to show the system icon again on a white background -->
    <style name="Theme.RentFlow.SplashTheme" parent="Base.Theme.RentFlow">
        <item name="android:windowBackground">#F9F9F9</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#F9F9F9</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher</item>
    </style>
</resources>
