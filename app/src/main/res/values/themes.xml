<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RentFlow" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary branding color -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/green_on_primary</item>
        <item name="colorPrimaryContainer">@color/green_primary_container</item>

        <!-- Status and background coloring -->
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.RentFlow" parent="Base.Theme.RentFlow" />
</resources>
